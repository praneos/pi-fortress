#!/usr/sbin/nft -f
flush ruleset

table inet fortress {
  set blacklist_v4 {
    type ipv4_addr
    flags interval
    elements = { 203.0.113.9 }
  }

  set dns_bypass_v4 {
    type ipv4_addr
    flags interval
    elements = { 198.51.100.7 }
  }

  set resolved_v4 {
    type ipv4_addr
    flags timeout
    timeout 2h
  }

  set direct_ip_v4 {
    type ipv4_addr
    flags interval
    elements = { 203.0.113.64/26 }
  }

  set resolved_desk_v4 {
    type ipv4_addr
    flags timeout
    timeout 2h
  }

  set resolved_guest_v4 {
    type ipv4_addr
    flags timeout
    timeout 2h
  }

  set agent_conn_v4 {
    type ipv4_addr
    size 65535
    flags dynamic
  }

  set seg_desk_conn_v4 {
    type ipv4_addr
    size 65535
    flags dynamic
  }

  set seg_guest_conn_v4 {
    type ipv4_addr
    size 65535
    flags dynamic
  }

  set reserved_v4 {
    type ipv4_addr
    flags interval
    elements = {
      0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
      169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
      192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
      224.0.0.0/4, 240.0.0.0/4
    }
  }

  chain filter_prerouting {
    type filter hook prerouting priority raw; policy accept;
    iifname "eth0" ip saddr != 10.77.0.0/24 limit rate 10/second burst 20 packets log prefix "pi-fortress agent-spoof: " level info
    iifname "eth0" ip saddr != 10.77.0.0/24 counter drop
    iifname "eth0.79" ip saddr != 10.79.0.0/30 limit rate 10/second burst 20 packets log prefix "pi-fortress desk-spoof: " level info
    iifname "eth0.79" ip saddr != 10.79.0.0/30 counter drop
    iifname "eth2" ip saddr != 10.80.0.0/24 limit rate 10/second burst 20 packets log prefix "pi-fortress guest-spoof: " level info
    iifname "eth2" ip saddr != 10.80.0.0/24 counter drop
    iifname "eth0" udp dport 53 fib daddr type local notrack
    iifname "eth0.79" udp dport 53 fib daddr type local notrack
    iifname "eth2" udp dport 53 fib daddr type local notrack
    iifname "eth0" meta nfproto ipv6 counter drop
    iifname "eth0" ip daddr @blacklist_v4 limit rate 10/second burst 20 packets log prefix "pi-fortress agent-blacklist: " level info
    iifname "eth0" ip daddr @blacklist_v4 counter drop
    iifname "eth0" ip daddr @dns_bypass_v4 limit rate 10/second burst 20 packets log prefix "pi-fortress agent-doh: " level info
    iifname "eth0" ip daddr @dns_bypass_v4 counter drop
    iifname "eth0" udp dport 443 counter drop
    iifname "eth0" tcp dport 80 ip daddr != 10.77.0.1 counter drop
    iifname "eth0" tcp dport 22 ip daddr != 198.18.0.0/16 counter drop
    iifname "eth0" udp dport 53 ip daddr != 10.77.0.1 counter drop
    iifname "eth0" tcp dport 53 ip daddr != 10.77.0.1 counter drop
    iifname "eth0" tcp dport 853 limit rate 10/second burst 20 packets log prefix "pi-fortress agent-doh: " level info
    iifname "eth0" tcp dport 853 counter drop
    iifname "eth0" udp dport 853 limit rate 10/second burst 20 packets log prefix "pi-fortress agent-doh: " level info
    iifname "eth0" udp dport 853 counter drop
    iifname "eth0.79" meta nfproto ipv6 counter drop
    iifname "eth0.79" ip daddr @blacklist_v4 limit rate 10/second burst 20 packets log prefix "pi-fortress desk-blacklist: " level info
    iifname "eth0.79" ip daddr @blacklist_v4 counter drop
    iifname "eth0.79" meta l4proto { tcp, udp } th dport 53 accept
    iifname "eth0.79" ip daddr @dns_bypass_v4 limit rate 10/second burst 20 packets log prefix "pi-fortress desk-doh: " level info
    iifname "eth0.79" ip daddr @dns_bypass_v4 counter drop
    iifname "eth0.79" udp dport 443 counter drop
    iifname "eth0.79" tcp dport 853 limit rate 10/second burst 20 packets log prefix "pi-fortress desk-doh: " level info
    iifname "eth0.79" tcp dport 853 counter drop
    iifname "eth0.79" udp dport 853 limit rate 10/second burst 20 packets log prefix "pi-fortress desk-doh: " level info
    iifname "eth0.79" udp dport 853 counter drop
    iifname "eth2" meta nfproto ipv6 counter drop
    iifname "eth2" ip daddr @blacklist_v4 limit rate 10/second burst 20 packets log prefix "pi-fortress guest-blacklist: " level info
    iifname "eth2" ip daddr @blacklist_v4 counter drop
    iifname "eth2" meta l4proto { tcp, udp } th dport 53 accept
    iifname "eth2" ip daddr @dns_bypass_v4 limit rate 10/second burst 20 packets log prefix "pi-fortress guest-doh: " level info
    iifname "eth2" ip daddr @dns_bypass_v4 counter drop
    iifname "eth2" udp dport 443 counter drop
    iifname "eth2" tcp dport 853 limit rate 10/second burst 20 packets log prefix "pi-fortress guest-doh: " level info
    iifname "eth2" tcp dport 853 counter drop
    iifname "eth2" udp dport 853 limit rate 10/second burst 20 packets log prefix "pi-fortress guest-doh: " level info
    iifname "eth2" udp dport 853 counter drop
  }

  chain raw_output {
    type filter hook output priority raw; policy accept;
    oifname "eth0" meta skuid "pf-dns" udp sport 53 notrack
    oifname "eth0.79" meta skuid "pf-dns" udp sport 53 notrack
    oifname "eth2" meta skuid "pf-dns" udp sport 53 notrack
  }

  chain resolver_gate {
    type filter hook prerouting priority -150; policy accept;
    iifname "eth0" tcp dport 443 ct state new ip daddr != 10.77.0.1 ip daddr != 192.0.2.0/24 ip daddr != @direct_ip_v4 ip daddr != 198.18.0.0/16 limit rate 10/second burst 20 packets log prefix "pi-fortress agent-directip: " level info
    iifname "eth0" tcp dport 443 ct state new ip daddr != 10.77.0.1 ip daddr != 192.0.2.0/24 ip daddr != @direct_ip_v4 ip daddr != 198.18.0.0/16 counter drop
    iifname "eth0.79" meta l4proto { tcp, udp } th dport != 53 ct state new ip daddr != 10.79.0.1 ip daddr != @resolved_desk_v4 ip daddr != 10.77.0.10-10.77.0.12 limit rate 10/second burst 20 packets log prefix "pi-fortress desk-directip: " level info
    iifname "eth0.79" meta l4proto { tcp, udp } th dport != 53 ct state new ip daddr != 10.79.0.1 ip daddr != @resolved_desk_v4 ip daddr != 10.77.0.10-10.77.0.12 counter drop
    iifname "eth0.79" icmp type echo-request ct state new ip daddr != 10.79.0.1 ip daddr != @resolved_desk_v4 ip daddr != 10.77.0.10-10.77.0.12 limit rate 10/second burst 20 packets log prefix "pi-fortress desk-directip: " level info
    iifname "eth0.79" icmp type echo-request ct state new ip daddr != 10.79.0.1 ip daddr != @resolved_desk_v4 ip daddr != 10.77.0.10-10.77.0.12 counter drop
    iifname "eth0.79" meta l4proto != { tcp, udp, icmp } ct state new ip daddr != 10.79.0.1 ip daddr != @resolved_desk_v4 ip daddr != 10.77.0.10-10.77.0.12 limit rate 10/second burst 20 packets log prefix "pi-fortress desk-directip: " level info
    iifname "eth0.79" meta l4proto != { tcp, udp, icmp } ct state new ip daddr != 10.79.0.1 ip daddr != @resolved_desk_v4 ip daddr != 10.77.0.10-10.77.0.12 counter drop
    iifname "eth0.79" icmp type != echo-request ct state new ip daddr != 10.79.0.1 ip daddr != @resolved_desk_v4 ip daddr != 10.77.0.10-10.77.0.12 limit rate 10/second burst 20 packets log prefix "pi-fortress desk-directip: " level info
    iifname "eth0.79" icmp type != echo-request ct state new ip daddr != 10.79.0.1 ip daddr != @resolved_desk_v4 ip daddr != 10.77.0.10-10.77.0.12 counter drop
  }

  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
    iifname "eth0" tcp dport 443 redirect to :8080
  }

  chain input {
    type filter hook input priority filter; policy drop;
    iifname "wlan0" meta nfproto ipv6 counter drop
    iifname "eth0" tcp dport 53 meter agent_dnsflood_tcp { ip saddr limit rate over 200/second burst 400 packets } counter drop
    iifname "eth0" udp dport 53 meter agent_dnsflood_udp { ip saddr limit rate over 200/second burst 400 packets } counter drop
    iifname "eth0.79" tcp dport 53 meter desk_dnsflood_tcp { ip saddr limit rate over 200/second burst 400 packets } counter drop
    iifname "eth0.79" udp dport 53 meter desk_dnsflood_udp { ip saddr limit rate over 200/second burst 400 packets } counter drop
    iifname "eth2" tcp dport 53 meter guest_dnsflood_tcp { ip saddr limit rate over 200/second burst 400 packets } counter drop
    iifname "eth2" udp dport 53 meter guest_dnsflood_udp { ip saddr limit rate over 200/second burst 400 packets } counter drop
    ct state established,related accept
    ct state invalid drop
    iifname "lo" accept
    iifname "eth0" meta l4proto tcp ct state new meter agent_newconn { ip saddr limit rate over 50/second burst 200 packets } jump agent_connlimit
    iifname "eth0" meta l4proto tcp ct state new add @agent_conn_v4 { ip saddr ct count over 128 } jump agent_connlimit
    iifname "eth0" meta l4proto tcp ct state new ct count over 4096 jump agent_connlimit
    iifname "eth0" meta l4proto tcp ct state new limit rate over 300/second burst 600 packets jump agent_connlimit
    iifname "eth0" tcp dport 80 accept
    iifname "eth0" tcp dport 8080 accept
    iifname "eth0" tcp dport 53 accept
    iifname "eth0" udp dport 53 accept
    iifname "eth0" icmp type echo-request meter agent_ping { ip saddr limit rate over 10/second burst 20 packets } counter drop
    iifname "eth0" icmp type echo-request accept
    iifname "eth0" limit rate 10/minute burst 20 packets log prefix "pi-fortress agent-drop: " level warn
    iifname "eth0" counter drop
    iifname "eth0.79" tcp dport 22 ct state new meter seg_desk_ssh { ip saddr limit rate over 30/minute burst 60 packets } counter drop
    iifname "eth0.79" tcp dport 22 ct state new accept
    iifname "eth0.79" tcp dport 53 accept
    iifname "eth0.79" udp dport 53 accept
    iifname "eth0.79" icmp type echo-request meter seg_desk_ping { ip saddr limit rate over 10/second burst 20 packets } counter drop
    iifname "eth0.79" icmp type echo-request accept
    iifname "eth0.79" limit rate 10/minute burst 20 packets log prefix "pi-fortress desk-drop: " level warn
    iifname "eth0.79" counter drop
    iifname "eth2" tcp dport 53 accept
    iifname "eth2" udp dport 53 accept
    iifname "eth2" icmp type echo-request meter seg_guest_ping { ip saddr limit rate over 10/second burst 20 packets } counter drop
    iifname "eth2" icmp type echo-request accept
    iifname "eth2" limit rate 10/minute burst 20 packets log prefix "pi-fortress guest-drop: " level warn
    iifname "eth2" counter drop
    iifname "wlan0" tcp dport 22 ct state new meter wan_ssh { ip saddr limit rate over 30/minute burst 60 packets } counter drop
    iifname "wlan0" tcp dport 22 ct state new accept
    iifname "wlan0" udp sport 67 udp dport 68 accept
    iifname "wlan0" icmp type echo-request meter wan_ping { ip saddr limit rate over 10/second burst 20 packets } counter drop
    iifname "wlan0" icmp type echo-request accept
    iifname "wlan0" counter drop
  }

  chain output {
    type filter hook output priority filter; policy accept;
    oifname "wlan0" meta nfproto ipv6 counter drop
    meta skuid "pf-broker" ip daddr @blacklist_v4 limit rate 10/second burst 20 packets log prefix "pi-fortress broker-blacklist: " level info
    meta skuid "pf-broker" ip daddr @blacklist_v4 counter drop
    meta skuid "pf-broker" ip daddr 9.9.9.9 udp dport 53 accept
    meta skuid "pf-broker" ip daddr 9.9.9.9 tcp dport 53 accept
    meta skuid "pf-broker" ip daddr @dns_bypass_v4 limit rate 10/second burst 20 packets log prefix "pi-fortress broker-doh: " level info
    meta skuid "pf-broker" ip daddr @dns_bypass_v4 counter drop
    ct state established,related accept
    oifname "eth0" meta skuid "pf-dns" udp sport 53 ct state untracked accept
    oifname "eth0.79" meta skuid "pf-dns" udp sport 53 ct state untracked accept
    oifname "eth2" meta skuid "pf-dns" udp sport 53 ct state untracked accept
    oifname "lo" accept
    meta skuid "pf-engine" counter drop
    meta skuid "pf-broker" ip daddr @reserved_v4 counter drop
    meta skuid "pf-broker" tcp dport 443 accept
    meta skuid "pf-broker" counter drop
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    iifname "eth0.79" ct state new meter seg_desk_newconn { ip saddr limit rate over 50/second burst 200 packets } jump seg_desk_connlimit
    iifname "eth0.79" ct state new add @seg_desk_conn_v4 { ip saddr ct count over 128 } jump seg_desk_connlimit
    iifname "eth0.79" ct state new ct count over 4096 jump seg_desk_connlimit
    iifname "eth0.79" ct state new meta l4proto tcp limit rate over 300/second burst 600 packets jump seg_desk_connlimit
    iifname "eth2" ct state new meter seg_guest_newconn { ip saddr limit rate over 50/second burst 200 packets } jump seg_guest_connlimit
    iifname "eth2" ct state new add @seg_guest_conn_v4 { ip saddr ct count over 128 } jump seg_guest_connlimit
    iifname "eth2" ct state new ct count over 4096 jump seg_guest_connlimit
    iifname "eth2" ct state new meta l4proto tcp limit rate over 300/second burst 600 packets jump seg_guest_connlimit
    ct state established jump isolate_ct
    ct state established,related accept
    ct state invalid drop
    iifname "eth0" ip daddr 198.18.0.0/16 tcp dport 22 counter reject with tcp reset
    iifname "eth0" oifname "eth0.79" counter drop
    iifname "eth0.79" oifname "eth0" ip daddr 10.77.0.10-10.77.0.12 tcp dport 22 ct state new accept
    iifname "eth0.79" oifname "eth0" counter drop
    iifname "eth0.79" oifname "eth2" counter drop
    iifname "eth0" oifname "eth2" counter drop
    iifname "eth2" oifname "eth0" counter drop
    iifname "eth2" oifname "eth0.79" counter drop
    iifname "eth0" meta nfproto ipv6 counter drop
    iifname "eth0" udp dport 443 counter drop
    iifname "eth0" tcp dport 80 counter drop
    iifname "eth0" tcp dport 22 counter drop
    iifname "eth0" counter drop
    iifname "eth0.79" meta nfproto ipv6 counter drop
    iifname "eth0.79" udp dport 53 reject with icmp type port-unreachable
    iifname "eth0.79" tcp dport 53 reject with tcp reset
    iifname "eth0.79" ip daddr @reserved_v4 limit rate 10/second burst 20 packets log prefix "pi-fortress desk-local: " level info
    iifname "eth0.79" ip daddr @reserved_v4 counter drop
    iifname "eth0.79" jump seg_desk_egress
    iifname "eth0.79" oifname "wlan0" accept
    iifname "eth0.79" counter drop
    iifname "eth2" meta nfproto ipv6 counter drop
    iifname "eth2" udp dport 53 reject with icmp type port-unreachable
    iifname "eth2" tcp dport 53 reject with tcp reset
    iifname "eth2" ip daddr @reserved_v4 limit rate 10/second burst 20 packets log prefix "pi-fortress guest-local: " level info
    iifname "eth2" ip daddr @reserved_v4 counter drop
    iifname "eth2" jump seg_guest_egress
    iifname "eth2" oifname "wlan0" accept
    iifname "eth2" counter drop
  }

  chain isolate_ct {
    iifname "eth0.79" oifname "eth0" ip daddr 10.77.0.10-10.77.0.12 tcp dport 22 ct direction original return
    iifname "eth0" oifname "eth0.79" ip saddr 10.77.0.10-10.77.0.12 tcp sport 22 ct direction reply return
    iifname "eth0" oifname "eth0.79" counter drop
    iifname "eth0.79" oifname "eth0" counter drop
    iifname "eth0.79" oifname "eth2" counter drop
    iifname "eth0" oifname "eth2" counter drop
    iifname "eth2" oifname "eth0" counter drop
    iifname "eth2" oifname "eth0.79" counter drop
  }

  chain seg_desk_egress {
    tcp dport 80 return
    tcp dport { 443, 465, 993, 5223, 5228, 8443 } return
    tcp dport { 143, 587 } return
    udp dport 123 return
    icmp type echo-request limit rate 10/second burst 20 packets return
    limit rate 10/second burst 20 packets log prefix "pi-fortress desk-port: " level info
    counter drop
  }

  chain seg_guest_egress {
    tcp dport 80 return
    tcp dport { 443, 465, 993, 5223, 5228, 8443 } return
    tcp dport { 143, 587 } return
    udp dport 123 return
    icmp type echo-request limit rate 10/second burst 20 packets return
    limit rate 10/second burst 20 packets log prefix "pi-fortress guest-port: " level info
    counter drop
  }

  chain agent_connlimit {
    limit rate 10/second burst 20 packets log prefix "pi-fortress agent-connlimit: " level info
    meta l4proto tcp counter reject with tcp reset
    counter drop
  }

  chain seg_desk_connlimit {
    limit rate 10/second burst 20 packets log prefix "pi-fortress desk-connlimit: " level info
    meta l4proto tcp counter reject with tcp reset
    counter drop
  }

  chain seg_guest_connlimit {
    limit rate 10/second burst 20 packets log prefix "pi-fortress guest-connlimit: " level info
    meta l4proto tcp counter reject with tcp reset
    counter drop
  }

  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr 10.77.0.0/24 oifname "wlan0" counter masquerade
    ip saddr 10.79.0.0/30 oifname "wlan0" counter masquerade
    ip saddr 10.80.0.0/24 oifname "wlan0" counter masquerade
  }
}
