[Unit]
Description=pi-fortress: switch USB NICs out of driver-CD mode
Documentation=file:///opt/pi-fortress/docs/user_guide/home_network.md
# Early, before the network is configured. Thus a house adapter that is
# connected at power-on is a NIC before anything looks for HOUSE_IF. The
# udev rule starts this unit again at each plug event.
DefaultDependencies=no
After=local-fs.target systemd-udevd.service systemd-udev-trigger.service
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/pi-fortress/usb-nic-switch.sh
TimeoutStartSec=90
# Root, with a sandbox. The script reads /sys/bus/usb/devices, runs
# usb_modeswitch and usbreset on the adapter in /dev/bus/usb, and writes 0
# and 1 to the authorized file of the adapter in /sys. It writes nothing
# else.
NoNewPrivileges=yes
ProtectHome=yes
# The file system is read-only, except /dev, /proc and /sys.
ProtectSystem=strict
# Not ProtectKernelTunables: it makes /sys read-only, and the authorized
# write is the last step of the recovery. Not PrivateDevices: it removes
# /dev/bus/usb. Not PrivateTmp: the script writes no temporary file, and
# this unit starts before most of the file systems are ready.
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_NETLINK: libusb in usb_modeswitch opens a kernel event socket, and
# stops if it cannot. AF_UNIX: the journal.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
# The same removal as in pf-broker.service (it gives the reason).
SystemCallFilter=~@aio @keyring userfaultfd
SystemCallErrorNumber=EPERM
# No capability. The kernel asks for none for the usbfs calls (the
# usb_modeswitch eject and driver detach, the usbreset port reset) or for
# the authorized file. Only the file mode controls them, and root owns
# those files. Root also owns each file that the script reads. A failure
# here is silent: the adapter stays in driver-CD mode, and the script
# still exits 0. Thus each step logs, and pf doctor names a stuck adapter.
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=sysinit.target
