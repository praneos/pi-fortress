# Operator overlay. apply sources it after net.env. Copy it to
# /etc/pi-fortress/net.env.local. Nothing in the tree ships this file or
# copies over it. Thus a value set here survives a ship. The same value
# set in net.env on the box does not.
#
# DNS over TLS (docs/user_guide/pi_setup.md). Both keys or neither.
#DOT_AUTH_NAME=dns.quad9.net
#DOT_IPS=9.9.9.9 149.112.112.112
# or a Control D profile (dig +short <id>.dns.controld.com for the IPs):
#DOT_AUTH_NAME=<id>.dns.controld.com
#DOT_IPS="<ip1> <ip2>"
#
# How pf dns answers the agent segment (see net.env). fakeip is the
# default. forward gives real answers, and a name lookup then leaves
# the Pi. With fakeip, SSH to an ssh_allow.ips host uses the address.
#AGENT_DNS=forward
#FAKEIP_NET=198.18.0.0/16
#
# Pin the interfaces. Do not detect them.
#INT_IF=eth0
#WAN_IF=wlan0
#
# Public Wi-Fi uplink: no SSH or ping on WAN_IF (docs/user_guide/public_wifi.md).
#UNTRUSTED_UPLINK=1
#
# Connection budgets (see net.env). A house with a torrent client or a
# busy NAS can need more per device. 0 disables one limit.
#HOUSE_CONN_PER_IP=4096
#HOUSE_NEW_PER_IP=200/1000
#HOUSE_NEW_TOTAL=2000/8000
