[Unit]
Description=pi-fortress house segment DHCP (dnsmasq)
After=network-online.target
Wants=network-online.target
# Always restart, with no limit (pf-broker.service gives the reason).
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=2
# Resource caps (pf-broker.service explains the scheme). A dnsmasq that does
# only DHCP, for a maximum of a few hundred leases, uses a few MiB. It is not
# Go, so no GOMEMLIMIT. It is the house DHCP, so the pf dns OOM score.
MemoryHigh=48M
MemoryMax=64M
TasksMax=64
LimitNOFILE=1024
OOMScoreAdjust=100
# systemd does the privilege drop, not dnsmasq. The dnsmasq drop has a
# getuid() == 0 guard. When dnsmasq starts as this account, it never calls
# setgroups/setgid/capset/prctl/setuid -- the full @privileged block that
# the sibling units deny. It keeps the three capabilities that the DHCP
# half uses. It gets them as ambient capabilities, not carried through a
# setuid with CAP_SETUID: NET_BIND_SERVICE for :67,
# NET_RAW for the ping-before-offer ICMP socket and SO_BINDTODEVICE,
# NET_ADMIN for the SIOCSARP cache injection. CAP_SETGID, CAP_SETUID,
# CAP_CHOWN and CAP_DAC_OVERRIDE are removed with the drop that needed them.
#
# Each DHCP instance has its own account (dhcp_account, lib/dhcp.sh).
# Thus an instance cannot write the lease file or the log of a different
# instance, or send a signal to it.
#
# Group: the primary group of the account. The compiled-in default
# of dnsmasq is "dip", the dial-out group, which dnsmasq does not need. No
# file on the box has the group nogroup. The two files that this daemon
# writes are pf-dhcp-house:root 0640 (apply.sh).
User=pf-dhcp-house
Group=nogroup
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW
RuntimeDirectory=pi-fortress-dns-house
# --user is still here, although systemd already set the uid. dnsmasq
# resolves it to a passwd entry and fchowns its log to that uid, if it is
# root or not ("failure of the chown call is OK", log.c). The flag names
# the account that we already run as. Thus that call is a no-op on a
# file we own. Without the flag, dnsmasq uses its built-in default,
# "nobody", and logs one EPERM warning at each start.
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/pi-fortress/dns-house.conf --user=pf-dhcp-house --pid-file=/run/pi-fortress-dns-house/dnsmasq.pid
ExecReload=+/bin/kill -HUP $MAINPID
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# AF_INET is for :67 and the ping-before-offer raw socket. AF_NETLINK is
# for the route socket that bind-dynamic watches for the house address.
# AF_UNIX is for the nss lookup and /dev/log. No AF_PACKET: on Linux, dnsmasq
# reads DHCP from a UDP socket with IP_PKTINFO, not from a packet socket.
RestrictAddressFamilies=AF_INET AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# @privileged includes @chown, and a filtered call kills the process.
# dnsmasq makes only the log fchown above. CAP_CHOWN is not in the
# bounding set, so that call can only set the owner that the file
# already has.
SystemCallFilter=@chown
# The lease file, nothing else under /var/lib/pi-fortress. dnsmasq
# rewrites it in place. apply.sh makes it before it starts the unit. The
# log directory, not the log file: logrotate renames the log, and dnsmasq
# opens the path again on SIGUSR2. A bind mount of the file would keep
# the old inode. The account owns only its own files there.
ReadWritePaths=/var/lib/pi-fortress/house.leases /var/log/pi-fortress
InaccessiblePaths=-/etc/pi-fortress/broker -/var/lib/pi-fortress/engine -/var/lib/pi-fortress/www

[Install]
WantedBy=multi-user.target
