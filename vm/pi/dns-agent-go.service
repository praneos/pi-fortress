[Unit]
Description=pi-fortress segment DNS (pf dns)
After=network-online.target
Wants=network-online.target
# Always restart, with no limit (pf-broker.service gives the reason).
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=2
# Resource caps (pf-broker.service explains the scheme). The cache, the
# fake-IP table (tens of MiB at a /16) and the held packets of the SNI
# queue are well below this. A low OOM score and the highest CPU weight:
# this one process is the DNS for all segments, also for the house.
MemoryHigh=200M
MemoryMax=256M
Environment=GOMEMLIMIT=160MiB
TasksMax=256
LimitNOFILE=4096
# The OOM killer takes it after the fence and after each unranked process:
# without it the house has no DNS. MemoryMax stops a leak in it first.
OOMScoreAdjust=-500
CPUWeight=200
# A Go daemon does not drop its own privilege or reopen a log that root
# owns. Thus systemd does both. The four capabilities that dnsmasq needed
# for that (SETGID, SETUID, CHOWN, DAC_OVERRIDE) are removed, and the process
# never runs as root. NET_BIND_SERVICE is for port 53, NET_ADMIN for the
# nft that it forks to feed resolved_v4 -- ambient, so that the fork
# inherits it. nft is in /usr/sbin, which stays readable with
# ProtectSystem=strict. No NET_RAW: pf dns pins each socket to its
# interface (SO_BINDTODEVICE) once, before it binds or connects it. The
# kernel (5.7 and later) lets a process with no capability do this on a
# socket that no device pins yet.
User=pf-dns
Group=pf-fortress
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
# One flag, one path. The old flags were one environment variable each,
# and could describe only one segment. The file is a list. Thus the house
# (and later a segments.d entry) is an element, not a second unit with a
# second cache and a second rebind timer. apply.sh writes the file, and
# pf dns -check validates those same bytes before the restart.
ExecStart=/usr/local/sbin/pf dns -config /etc/pi-fortress/dns.json
ExecReload=+/bin/kill -HUP $MAINPID
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# AF_INET: the listeners are udp4/tcp4 by name (internal/dnsd/serve.go),
# and a segment address that is not v4 is refused. Thus there is no v6
# socket to allow. AF_UNIX is stderr to the journal. AF_NETLINK is for
# the nft that it forks to add an answer to resolved_v4 (nfnetlink under
# this same filter), for the SNI queue, and for one rtnetlink socket that
# gets link and address events. With these events pf dns opens the
# listeners of a segment again when its interface comes back with a new
# index (internal/dnsd/linkwatch.go).
RestrictAddressFamilies=AF_INET AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# The same removal as in pf-broker.service (it gives the reason).
SystemCallFilter=~@aio @keyring userfaultfd
# The fake-IP journal (AGENT_DNS=fakeip): pf dns is its only writer. The
# broker is its only reader, through the pf-fakeip group on the directory.
# apply makes that directory pf-dns:pf-fakeip 2750. "-" because a forward-mode
# box never has it, and a missing ReadWritePaths entry would fail the unit.
ReadWritePaths=/var/log/pi-fortress -/var/lib/pi-fortress/dns
InaccessiblePaths=-/etc/pi-fortress/broker -/var/lib/pi-fortress/engine -/var/lib/pi-fortress/www

[Install]
WantedBy=multi-user.target
