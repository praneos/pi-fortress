[Unit]
Description=pi-fortress DNS-over-TLS stub %i (pf dns on loopback)
After=network-online.target
Wants=network-online.target
# All units that forward to the stub start after it: the resolver
# for all segments, and the house dnsmasq that keeps DHCP.
Before=pi-fortress-dns-house.service pi-fortress-dns-agent-go.service
# Always restart, with no limit (pf-broker.service gives the reason).
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=2
# Resource caps (pf-broker.service explains the scheme). A loopback
# forwarder with almost no cache and no log. It is the DNS for all that is
# behind it, so it has the pf dns OOM score and CPU weight.
MemoryHigh=96M
MemoryMax=128M
Environment=GOMEMLIMIT=80MiB
TasksMax=128
LimitNOFILE=1024
OOMScoreAdjust=-500
CPUWeight=200
# The same account as the agent resolver. Thus one uid covers all stubs
# in the 853 pin of the output chain. apply creates the account, not a
# package. Thus no packaging step can cause it to be missing.
#
# %i is the instance: "main" answers the box and the agents. "house"
# exists only when the house resolves through a different provider
# (docs/user_guide/home_network.md). Only their config files are different.
User=pf-dns
Group=pf-fortress
# Port 53, and NET_RAW for the SO_BINDTODEVICE pin on lo. No NET_ADMIN:
# this segment feeds no nft set, so it never forks nft.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
# One -config file for each instance. apply writes and checks it before
# the ruleset loads. No sinkhole list and no query log, both on purpose
# (see stub_config in apply.sh). apt and the feed fetches must not get
# the agent blocklist. The lookups of the box itself must not go into the
# log that pf observe parses as client traffic.
ExecStart=/usr/local/sbin/pf dns -config /etc/pi-fortress/dns-stub-%i.json
ExecReload=+/bin/kill -HUP $MAINPID
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# One family less than the agent resolver. The stub feeds no nft set,
# so it forks nothing that needs netlink. It holds no netlink socket
# itself. The outbound DoT dial is tcp to a pinned literal. pf render and
# pf dns both refuse it unless it is v4. Thus AF_INET covers the
# listener on lo and the upstream. AF_UNIX is stderr to the journal.
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# The same removal as in pf-broker.service (it gives the reason).
SystemCallFilter=~@aio @keyring userfaultfd
ReadWritePaths=
InaccessiblePaths=-/etc/pi-fortress/broker -/var/lib/pi-fortress/engine -/var/lib/pi-fortress/www

[Install]
WantedBy=multi-user.target
