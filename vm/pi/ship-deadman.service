[Unit]
Description=pi-fortress ship dead-man: revert an unconfirmed upgrade
Documentation=file:///opt/pi-fortress/docs/signed_ship.md

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pf ship deadman
UMask=0022
TimeoutStartSec=15min
# The same sandbox as ship.service, which gives the reason for each line:
# a revert is the same swap and full apply as a ship.
MemoryHigh=768M
MemoryMax=1G
TasksMax=256
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
# The same removal as in pf-broker.service (it gives the reason).
SystemCallFilter=~@aio @keyring userfaultfd
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_LINUX_IMMUTABLE CAP_SYS_PTRACE CAP_AUDIT_WRITE CAP_SYS_ADMIN
ReadWritePaths=/etc /opt /usr/local /var/lib/pi-fortress /var/log/pi-fortress -/var/lib/systemd/timesync -/run/pi-fortress -/vagrant/vm/policy/generated
