[Unit]
Description=pi-fortress blocklist feed refresh
After=network-online.target
Wants=network-online.target
# Limits the lock retries below: 20 starts in one hour, then the unit fails.
StartLimitIntervalSec=1h
StartLimitBurst=20

[Service]
Type=oneshot
# --refresh is apply --local plus the feed refresh, in one process. Thus
# it holds the apply lock for both, and cannot interleave with an apply that
# an operator starts from the TUI. The download is not in this unit: pf
# feeds run starts pi-fortress-feeds.service, which downloads as pf-feeds,
# and then imports only the lines that it checked. It reloads nft and the resolvers. It does
# not restart the fence, because a restart drops live agent connections at
# any hour that this timer fires. The compiled list is then newer than the
# copy in the fence until the next operator apply. apply.sh and the TUI
# both show this. They do not leave it for the operator to find.
ExecStart=/usr/local/sbin/pf apply --refresh
# 75 means that a different apply has the lock (a ship, the TUI, an operator).
# Without a retry, that one collision loses the refresh for the day.
# systemd 252 (bookworm) refuses RestartForceExitStatus= on a oneshot and
# drops the full unit. Thus each failure retries, with StartLimit as the limit.
Restart=on-failure
# 3 is "applied, not settled" from apply.sh: the feeds are in, and a segment
# interface is missing (a house adapter that is not connected, or not yet a
# NIC). A retry cannot connect it, so 3 is not a failure to retry.
SuccessExitStatus=3
RestartSec=2min
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
# Root, with a sandbox. apply --refresh changes the box: it loads nft,
# sets sysctls, adds the daemon accounts, writes /etc and restarts units.
# Each of these needs root, so a User= here would stop the refresh. The
# sandbox limits the effect of a mistake in apply. It is not a security
# boundary: this unit can write /etc and talks to systemd. Thus the unit
# opens no IP socket, and the download runs in pi-fortress-feeds.service.
#
# Resource caps (pf-broker.service explains the scheme). The run is the
# import of the lists, pf compile and nft with the full feed sets.
MemoryHigh=768M
MemoryMax=1G
# The OOM killer takes the refresh first. The live lists stay, and the
# timer runs it again.
OOMScoreAdjust=800
TasksMax=256
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# Not ProtectKernelTunables: apply writes net.ipv4.ip_forward and the
# conntrack and ARP sysctls, and a failed ip_forward write stops it.
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Not RestrictSUIDSGID: apply makes setgid directories (the fake-IP
# journal directory is 2750).
# AF_NETLINK is for nft, ip, conntrack and ss. AF_UNIX is for systemctl
# and nmcli. No AF_INET or AF_INET6: nothing in a --local apply opens an
# IP socket (pf dns -check binds none).
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# Hides the processes of other users. Not ProcSubset=pid: apply writes
# /proc/sys/net.
ProtectProc=invisible
SystemCallArchitectures=native
SystemCallFilter=@system-service
# The same removal as in pf-broker.service (it gives the reason).
SystemCallFilter=~@aio @keyring userfaultfd
# A call outside the set fails with EPERM. A kill would stop the script
# between two steps of a change to the box, with no message.
SystemCallErrorNumber=EPERM
# NET_ADMIN: nft, ip, conntrack and the network sysctls. CHOWN, FOWNER,
# FSETID, DAC_OVERRIDE and DAC_READ_SEARCH: the files of the daemon
# accounts. LINUX_IMMUTABLE: chattr on /etc/resolv.conf. AUDIT_WRITE:
# useradd and groupadd. No SYS_PTRACE: ssh_local_addrs (lib/netman.sh)
# finds the admin SSH sessions by port, not by process.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_LINUX_IMMUTABLE CAP_AUDIT_WRITE
# All of /etc: useradd replaces /etc/passwd and /etc/group through a
# rename, and apply writes nftables.conf, resolv.conf and files in many
# directories under /etc. /usr/local: apply installs pf there. The tree:
# pf feeds run writes only generated/ and feeds-in/. A full apply makes
# generated/, and the timer exists only after a full apply. /run/pi-fortress: the apply lock.
# Each "-" path is optional, because a box has only one of the two trees.
ReadWritePaths=/etc /usr/local /var/lib/pi-fortress /var/log/pi-fortress -/var/lib/systemd/timesync -/run/pi-fortress -/opt/pi-fortress/vm/policy/generated -/vagrant/vm/policy/generated
# A --local apply does not use the secrets, the CA key or the claims. Only
# a full apply does.
InaccessiblePaths=-/etc/pi-fortress/broker -/var/lib/pi-fortress/engine -/var/lib/pi-fortress/www
