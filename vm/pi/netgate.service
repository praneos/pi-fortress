[Unit]
Description=pi-fortress netgate (gate set writes, SNI queue, conntrack dump)
After=network-online.target nftables.service
Wants=network-online.target
# pf dns asks netgate for each write to a gate set, and observe for the
# conntrack table. Thus netgate is up first. A start of pf dns does not
# wait for it, and pf dns fails closed (SERVFAIL) until it answers.
Before=pi-fortress-dns-agent-go.service pi-fortress-observe.service
# Always restart, with no limit (pf-broker.service gives the reason).
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
# Short and fixed, as for pf dns: while netgate is down, each answer that
# is not in the cache of pf dns is SERVFAIL.
RestartSec=1
# Resource caps (pf-broker.service explains the scheme). netgate itself
# holds small fixed messages. The nft and conntrack processes that it
# forks count in the memory of this unit: up to 16 nft at one time, each
# with the cache of the table, and one conntrack. Thus the memory caps are
# those of pf dns, which forked the same nft before. GOMEMLIMIT is for
# the Go heap only. The OOM rank and the CPU weight of pf dns: without
# netgate, the segments get no new DNS answer.
MemoryHigh=200M
MemoryMax=256M
Environment=GOMEMLIMIT=40MiB
TasksMax=128
LimitNOFILE=256
OOMScoreAdjust=-500
CPUWeight=200
# Its own account, in no group of the other daemons. It reads no log and
# no state. pf-dnsgate is the primary group of the agent resolver only,
# and pf-ctgate is a group of observe only. netgate is in them only to
# give each group to the socket of its client, dns.sock and ct.sock (a
# chown to a group of the owner needs no capability).
User=pf-netgate
Group=nogroup
SupplementaryGroups=pf-dnsgate pf-ctgate
# The sockets start with no access for the group or for others. netgate
# opens each one to the group of its client after it sets that group.
UMask=0077
# Not /run/pi-fortress, which only root and pf-fence can enter. pf dns
# and observe enter this directory, and only the group of a socket opens
# it.
RuntimeDirectory=pi-fortress-netgate
RuntimeDirectoryMode=0755
# NET_ADMIN only. netgate binds the SNI queue of the house and gives each
# verdict that pf dns sends back. The kernel checks NET_ADMIN on each of
# these netlink messages, also on a socket that a different process
# opened, so pf dns cannot get the queue as a file descriptor. It is
# ambient, because the nft and the conntrack that netgate forks need it
# too. Both are in /usr/sbin, which stays readable with
# ProtectSystem=strict.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
# dns.json gives the nft table, the gate sets and the SNI queues. apply
# writes it, and restarts netgate before pf dns, so that both read the
# same file.
ExecStart=/usr/local/sbin/pf netgate run -config /etc/pi-fortress/dns.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# AF_UNIX: the sockets of the clients, and stderr to the journal.
# AF_NETLINK: nft, conntrack and the SNI queue (nfnetlink). No AF_INET:
# netgate, nft and conntrack open no network socket.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# @privileged includes @chown, and a filtered call kills the process. The
# chown of a socket to the group of its client is the one chown.
SystemCallFilter=@chown
# The same removal as in pf-broker.service (it gives the reason).
SystemCallFilter=~@aio @keyring userfaultfd
# It writes nothing outside RuntimeDirectory. It reads no log, no state,
# no claim code, no webhook URL and no house reservation.
ReadWritePaths=
InaccessiblePaths=-/etc/pi-fortress/broker -/var/lib/pi-fortress/engine -/var/lib/pi-fortress/www -/var/log/pi-fortress -/var/lib/pi-fortress/observe -/etc/pi-fortress/alert.url -/etc/pi-fortress/house.hosts

[Install]
WantedBy=multi-user.target
