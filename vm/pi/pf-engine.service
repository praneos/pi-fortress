[Unit]
Description=pi-fortress TLS engine
After=network-online.target pi-fortress-broker.service
Wants=network-online.target pi-fortress-broker.service
Conflicts=pi-fortress-mitm.service
# Always restart, with no limit (pf-broker.service gives the reason).
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
# The same increasing back-off as the broker (pf-broker.service gives the
# reason). The agent also drives the engine, and the same load can loop it.
# pf dns, dnsmasq and the sidecars keep their fixed short RestartSec.
# No agent can push them into a kill loop past their caps. DNS and DHCP
# for the house must come back immediately, not after a minute.
RestartSec=5
RestartSteps=4
RestartMaxDelaySec=60
# Resource caps (pf-broker.service explains the scheme). The engine
# accepts 256 connections. At about 150 KiB each, that is 40 MiB. The rest
# is for the Go runtime and the hello peek buffers.
MemoryHigh=200M
MemoryMax=256M
Environment=GOMEMLIMIT=160MiB
TasksMax=256
LimitNOFILE=4096
OOMScoreAdjust=300
User=pf-engine
Group=pf-fortress
SupplementaryGroups=pf-fence
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# The same removal as in pf-broker.service (it gives the reason).
SystemCallFilter=~@aio @keyring userfaultfd
ReadWritePaths=-/run/pi-fortress/broker
# The engine is in pf-fortress, the group of the claims directories. The
# live claim codes are in claims/ and in the ledger. Thus the engine gets no
# path to the www directory. apply makes that directory before it starts a
# daemon, so the optional "-" never skips it.
#
# The engine reads none of these: the logs, the observe state, the webhook
# URL (alert.url) and the house reservations (house.hosts). Thus it gets
# no path to them. A box with no webhook or no house has no alert.url or
# house.hosts, hence the "-".
InaccessiblePaths=-/etc/pi-fortress/broker -/var/lib/pi-fortress/www -/var/log/pi-fortress -/var/lib/pi-fortress/observe -/etc/pi-fortress/alert.url -/etc/pi-fortress/house.hosts
EnvironmentFile=-/etc/pi-fortress/engine.env
EnvironmentFile=-/etc/pi-fortress/paranoid.flags
EnvironmentFile=/etc/pi-fortress/net.env
# apply sources the operator overlay after net.env. Thus PI_IP here must
# be the merged value. If not, the engine listens on an address to which
# the new ruleset from apply sends nothing. Optional: most boxes have
# no overlay, and a required EnvironmentFile that is absent fails the unit.
EnvironmentFile=-/etc/pi-fortress/net.env.local
ExecStart=/usr/local/sbin/pf engine -listen ${PI_IP}:8080 -sock /run/pi-fortress/broker/broker.sock -ca /var/lib/pi-fortress/engine/ca.pem -blocked /etc/pi-fortress/blocked-domains.conf -rules /etc/pi-fortress/key_prefixes.rules $PF_PARANOID_ENGINE_FLAGS $PF_ENGINE_FLAGS

[Install]
WantedBy=multi-user.target
