[Unit]
Description=pi-fortress secrets broker
After=network-online.target
Wants=network-online.target
Before=pi-fortress-engine.service
# Always restart, with no limit. The default systemd start limit (5 starts
# in 10 s) changes a crash loop into a unit that stays failed until a person
# logs in. On an unattended gateway, that is the outage. With RestartSec=1,
# a daemon got to that limit in five seconds. With 2, it was almost at the
# limit. MemoryMax keeps each cycle of a loop in the memory of this unit.
# The box does not thrash first.
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
# The back-off increases. Thus a kill loop becomes a slow loop, not one
# restart every few seconds. (In a kill loop, the load that OOM-kills the
# broker is still there when the broker starts again.) The delays are 5 s,
# then about 9, 17, 32 and 60 s, then 60 s each time. The Pi runs trixie
# (systemd 257). RestartSteps and RestartMaxDelaySec came in 254. An older
# systemd logs them as unknown and keeps the fixed 5 s. The steps count
# NRestarts. Only a manual start (each ship and apply) resets NRestarts.
# Thus a broker that crashed a few times in a month can wait up to one
# minute after its next crash. That is a maximum of 60 s of fence outage.
# In exchange, a live flood does not get a new process every 5 s. Not
# RestartPreventExitStatus: an OOM kill is SIGKILL, which that setting
# cannot isolate. A broker that stays down is the outage.
RestartSec=5
RestartSteps=4
RestartMaxDelaySec=60
# Resource caps. The Pi 5
# has 4 GB and no swap. Before these caps, each daemon could grow until the
# kernel OOM killer selected one, almost certainly this one, after the box
# had already thrashed. The agent drives the broker: the OOM paths that the
# audit found are 256 connections of buffered bodies and WebSocket messages.
# MemoryHigh throttles and reclaims before MemoryMax kills. The kill
# affects only this unit, and systemd restarts it after RestartSec.
# GOMEMLIMIT is below MemoryHigh. Thus the Go collector works harder as the
# heap comes near it, and the heap does not double past it (GOGC=100).
# broker.env, read after this line, can override it. OOMScoreAdjust sets
# the order for a global OOM: the broker first (500), the engine and the
# sidecars (300), pf dns and dnsmasq (100) last of ours. Reason: DNS and DHCP
# for the house must stay up longer than the agent fence. sshd is below all
# of them (its own -1000, and the ssh.service drop-in from apply). TasksMax
# and LimitNOFILE are 256 connections, two sockets each, plus logs and
# spare capacity. Go raises its soft file limit to the hard limit, and
# LimitNOFILE sets both, so this is the real ceiling. CPUWeight lets pf
# dns take CPU time from a busy fence without a hard quota.
MemoryHigh=850M
MemoryMax=1G
Environment=GOMEMLIMIT=700MiB
TasksMax=512
LimitNOFILE=8192
OOMScoreAdjust=500
CPUWeight=50
User=pf-broker
Group=pf-fence
SupplementaryGroups=pf-fortress pf-fakeip
RuntimeDirectory=pi-fortress/broker
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# @privileged includes @chown, and a filtered call kills the process. The
# store keeps the group of a file when it rewrites the file. Without
# CAP_CHOWN, it can give the file only to a group that this user is in.
SystemCallFilter=@chown
ReadWritePaths=/etc/pi-fortress/broker /var/log/pi-fortress
InaccessiblePaths=-/var/lib/pi-fortress/engine -/var/lib/pi-fortress/www
EnvironmentFile=-/etc/pi-fortress/broker.env
EnvironmentFile=-/etc/pi-fortress/paranoid.flags
# PF_FAKEIP_BROKER_FLAGS: -fakeip-net, -fakeip-journal and -resolver
# with AGENT_DNS=fakeip, empty otherwise. The broker reads the journal
# through the pf-fakeip group (SupplementaryGroups above; apply adds this
# user to it). apply creates this group before it installs this unit.
EnvironmentFile=-/etc/pi-fortress/fakeip.flags
EnvironmentFile=/etc/pi-fortress/net.env
# apply sources the operator overlay after net.env. Thus AGENT_NET here
# must be the merged value. If not, the broker gives credentials to a
# subnet that the fence does not guard. Optional: most boxes have no
# overlay, and a required EnvironmentFile that is absent fails the unit.
EnvironmentFile=-/etc/pi-fortress/net.env.local
ExecStart=/usr/local/sbin/pf broker -sock /run/pi-fortress/broker/broker.sock -admin-sock /run/pi-fortress/broker/admin.sock -policy /etc/pi-fortress/core.hosts -rules /etc/pi-fortress/key_prefixes.rules -allow /etc/pi-fortress/allow.domains -secrets /etc/pi-fortress/broker/secrets.env -agent-net=${AGENT_NET} -blocked /etc/pi-fortress/blocked-domains.conf -git-push /etc/pi-fortress/git_push.allow $PF_BROKER_FLAGS $PF_PARANOID_BROKER_FLAGS $PF_FAKEIP_BROKER_FLAGS
# A new broker process reads the current system CA roots. Thus each start
# removes the marker that ca-restart.sh writes when a sealed store kept it
# from a restart (pf doctor rung ca). + runs only this command as root and
# outside the sandbox; the broker itself keeps the sandbox above. - keeps a
# failed removal from failing the start.
ExecStartPost=-+/bin/rm -f /var/lib/pi-fortress/ca-restart-pending

[Install]
WantedBy=multi-user.target
