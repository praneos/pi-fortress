[Unit]
Description=pi-fortress observe (DNS + conntrack)
After=network-online.target pi-fortress-dns-agent.service pi-fortress-netgate.service
Wants=pi-fortress-dns-agent.service pi-fortress-netgate.service
# Always restart, with no limit (pf-broker.service gives the reason).
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=2
# Resource caps (pf-broker.service explains the scheme). The process
# rebuilds its largest structure from conntrack at each poll, so it grows
# with the table. 131072 entries (apply.sh) fit in this with spare space.
MemoryHigh=200M
MemoryMax=256M
Environment=GOMEMLIMIT=160MiB
TasksMax=128
LimitNOFILE=1024
OOMScoreAdjust=300
# Its own account. apply.sh makes it, and gives it the state directory,
# observe.jsonl and notice.jsonl. pf-fortress reads the query logs and
# strip.jsonl of the other daemons.
User=pf-observe
Group=pf-fortress
# systemd-journal: journalctl _TRANSPORT=kernel for the nft drop lines
# (ProtectKernelLogs closes /dev/kmsg; -k needs the boot ID, which
# ProcSubset=pid hides). pf-leases: the DHCP lease files, for the client
# names (apply.sh and lib/dhcp.sh give them this group). pf-ctgate: the
# socket of pf netgate for the conntrack table. No other unit has it.
SupplementaryGroups=systemd-journal pf-leases pf-ctgate
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# No capability. The conntrack dump over ctnetlink needs CAP_NET_ADMIN,
# so pf netgate runs `conntrack -L -o extended` for observe and streams
# the output back over /run/pi-fortress-netgate/ct.sock. Thus code that
# runs in observe cannot change the ruleset, a route, a link or a bridge.
# When netgate is down, the flow and volume rows stop, and observe says so
# in the journal. All files that observe reads are readable by its
# account or its groups, so it needs no DAC capability.
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# @privileged includes @chown, and a filtered call kills the process. The
# state file keeps the group of the file that it replaces (pf-fortress).
SystemCallFilter=@chown
# The same removal as in pf-broker.service (it gives the reason).
SystemCallFilter=~@aio @keyring userfaultfd
# Its own state directory and the logs, nothing else. The other state
# under /var/lib/pi-fortress (dns/, the alert offsets) is read-only here.
# The www directory, with the claim codes, is not visible here. apply.sh makes the directory, owned by
# pf-observe, before the unit starts. In /var/log/pi-fortress, the
# account can write only the files that it owns.
ReadWritePaths=/var/lib/pi-fortress/observe /var/log/pi-fortress
InaccessiblePaths=-/etc/pi-fortress/broker -/var/lib/pi-fortress/engine -/var/lib/pi-fortress/www
# Write chunking: first-seen rows, offsets
# and state stay in memory until one of the two limits. A crash loses that data.
#Environment=PF_OBSERVE_FLUSH_BYTES=10485760
#Environment=PF_OBSERVE_FLUSH_INTERVAL=15m
# Outbound volume: the MB that one client may send to one
# destination in one hour before a `volume` alert. 0 disables the signal.
#Environment=PF_OBSERVE_VOLUME_MB=500
# DNS tunnel heuristic: the number of distinct query names a
# minute, from one client under one registrable domain, that is a sign by
# itself. 0 disables the signal, and also the label and TXT rules.
#Environment=PF_OBSERVE_TUNNEL_NAMES=120
ExecStart=/usr/local/sbin/pf observe run

[Install]
WantedBy=multi-user.target
