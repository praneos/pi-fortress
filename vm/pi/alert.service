[Unit]
Description=pi-fortress strip alerts
After=network-online.target
# Always restart, with no limit (pf-broker.service gives the reason).
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=2
# Resource caps (pf-broker.service explains the scheme). Bounded maps
# and a small number of files or sockets.
MemoryHigh=96M
MemoryMax=128M
Environment=GOMEMLIMIT=80MiB
TasksMax=64
LimitNOFILE=1024
# The fence daemons get a positive OOM rank, so that the OOM killer takes
# them first. DNS and DHCP get -500. This unit posts the pressure
# alert, so it must be the last to go when RAM is short. -900, not -1000:
# the kernel can still stop it if it leaks, and MemoryMax stops it first.
OOMScoreAdjust=-900
# Reclaim does not take the first 32M of this unit. With CPUWeight and
# Nice, it gets the CPU before the other units when they compete. IOWeight
# has an effect only with an I/O scheduler that uses weights (BFQ).
MemoryMin=32M
CPUWeight=1000
IOWeight=1000
Nice=-10
# pf alert run locks its pages in RAM (mlockall, MCL_ONFAULT). The kernel
# counts the full address space of the Go runtime (about 1 GiB) against
# this limit, not the pages in use. A finite value refuses the lock, or
# stops the Go runtime later when its heap grows. MemoryMax is the real
# bound on the locked pages.
LimitMEMLOCK=infinity
User=pf-sidecar
Group=pf-fortress
# The group of alert.url (0640 root:pf-sidecar, apply.sh). Only this unit
# gets it. monitor runs as the same user without it.
SupplementaryGroups=pf-sidecar
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# No ProcSubset=pid: the pressure watch reads /proc/pressure, /proc/meminfo,
# /proc/loadavg, /proc/stat and the boot ID. ProtectKernelTunables keeps
# them read-only. The processes of other users stay hidden. The top lists
# come from the cgroups of the units, not from /proc/<pid>.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# The same removal as in pf-broker.service (it gives the reason).
SystemCallFilter=~@aio @keyring userfaultfd
# The three files that the sidecar rewrites in place, nothing else. It
# only reads the logs. apply.sh makes the files, owned by pf-sidecar,
# before it starts the unit. A "-" lets the unit start before the first
# apply. Then the sidecar cannot save its place until apply restarts it.
ReadWritePaths=-/var/lib/pi-fortress/alert.offset -/var/lib/pi-fortress/alert-notice.offset -/var/lib/pi-fortress/alert.last
# The pressure state file (pressure.json) and the open window of the block
# digest (digest.json). systemd makes this directory,
# owned by pf-sidecar, and makes it writable. The state is replaced with a
# rename, and a rename needs a directory that the unit can write.
StateDirectory=pi-fortress/alert
InaccessiblePaths=-/etc/pi-fortress/broker -/var/lib/pi-fortress/engine -/var/lib/pi-fortress/www
# PF_ALERT_FLAGS: the -pressure-* thresholds, or -pressure=false
# (docs/user_guide/pi_setup.md "Pressure alerts"), and -digest, or
# -digest=0 (the same page, "Block digest"). apply does not write
# this file. The operator does, and then restarts the unit.
EnvironmentFile=-/etc/pi-fortress/alert.env
ExecStart=/usr/local/sbin/pf alert run $PF_ALERT_FLAGS

[Install]
WantedBy=multi-user.target
