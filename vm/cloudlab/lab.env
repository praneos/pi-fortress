# Cloud lab settings (docs/cloud_lab.md). Plain KEY=value. Readers are
# vm/cloudlab/Vagrantfile, vm/cloudlab/lab.sh and, through PF_LAB_ENV,
# vm/itest. In vm/itest, its keys override vm/pi/net.env.

# The libvirt NAT network that each VM boots on. It is the WAN of the gw.
# The clients lose their link to it after provisioning (lab.sh cut).
MGMT_NET=192.168.124.0/24
# The address that the agents must never reach directly. vm/itest calls
# it VBOX_NAT_GW, after the VirtualBox lab that it came from.
VBOX_NAT_GW=192.168.124.1

# Host bridges, one libvirt network each. The trunk is the cable from
# the desktop to the Pi 5: VLAN 20 for agents, VLAN 79 for the desk.
TRUNK_BR=pftrunk0
AGENT_BR=pfagent0
HOUSE_BR=pfhouse0
# A veth pair connects them. One end is on the trunk. The other end has
# the VLAN 20 child, which is on the agent bridge. This is enp6s0.20 of
# the desktop. Thus an agent sees VLAN 20 untagged, and nothing else.
VETH_TRUNK=pfvt0
VETH_AGENT=pfva0
AGENT_VLAN=20
DESK_VLAN=79

# Fixed MACs, so guest scripts find each NIC without guessing names.
GW_MGMT_MAC=52:54:00:a0:00:01
GW_TRUNK_MAC=52:54:00:77:00:01
GW_HOUSE_MAC=52:54:00:78:00:01
HOUSE_MGMT_MAC=52:54:00:a0:00:20
HOUSE_MAC=52:54:00:78:00:20
# House pool devices (guest/house-ns.sh). The first octet of the phone has
# the locally administered bit set, as in the randomised Wi-Fi MAC of a phone.
HOUSE_PHONE_MAC=56:54:00:78:00:31
HOUSE_IOT_MAC=52:54:00:78:00:32
DESK_MGMT_MAC=52:54:00:a0:00:79
DESK_MAC=52:54:00:79:00:02
# Agent n gets 10.77.0.(9+n) and these prefixes plus that number.
AGENT_MGMT_MAC_PREFIX=52:54:00:a0:01
AGENT_MAC_PREFIX=52:54:00:77:00
