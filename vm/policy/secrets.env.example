# Always slotted. Env key is <16hex>_<KIND>, dummy is pf_<16hex>_<KIND>.
# Never put a live token on the agent. Mint on the Pi:
#
#   sudo pi-fortress-enroll mint --kind CLAUDE --oat 'sk-ant-oat01-...' --ort 'sk-ant-ort01-...'
#   sudo pi-fortress-enroll mint --kind ANTHROPIC_API_KEY --value 'sk-ant-api03-...'
#   sudo pi-fortress-enroll mint --kind GITHUB_TOKEN --value 'ghp_...'
#
# Each mint allots a new 16-hex slot. Claude oat+ort share one slot.
# `apply` migrates leftover unslotted KEY=value rows.
